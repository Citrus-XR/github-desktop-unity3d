# Maintainer: Citrus-XR / NekoShatoo <nazimishatoo@gmail.com>
pkgname=desktop-u
pkgver=3.5.13.beta2
pkgrel=1
pkgdesc="Simple collaboration from your desktop, Unity fork (from source)"
arch=('x86_64')
url="https://github.com/Citrus-XR/github-desktop-unity3d"
license=('MIT')
depends=(
  'gtk3'
  'libsecret'
  'libxss'
  'nss'
  'nspr'
  'libnotify'
)
optdepends=(
  'gnome-keyring: OAuth/credential storage on GNOME'
  'kwallet: OAuth/credential storage on KDE'
  'git: run git operations against your local repositories'
)
# Explicitly no `nodejs` makedep. Arch ships `nodejs` 26.x, whose stricter
# stream handling silently truncates extract-zip@2.0.1 mid-extract during
# electron's postinstall (produces an empty node_modules/electron/dist and
# packaging then fails). The upstream .nvmrc pins 24.15.0; download that
# tarball via makepkg's source array and use it locally for prepare()+build().
_nodever=24.15.0
makedepends=(
  'git'
  'python'
)
source=(
  "git+https://github.com/Citrus-XR/github-desktop-unity3d.git#commit=89472d07535d362d7d18800489a2d2dff1596671"
  "https://nodejs.org/dist/v${_nodever}/node-v${_nodever}-linux-x64.tar.xz"
)
sha256sums=(
  'SKIP'
  '472655581fb851559730c48763e0c9d3bc25975c59d518003fc0849d3e4ba0f6'
)

_srcdir="github-desktop-unity3d"
_nodedir="node-v${_nodever}-linux-x64"

prepare() {
  cd "$_srcdir"
  export PATH="$srcdir/${_nodedir}/bin:$PATH"
  # Playwright ffmpeg is only needed by the E2E test suite (yarn test:e2e:*),
  # and its download hangs indefinitely when the Playwright CDN is unreachable
  # (which strands makepkg with no way to know why). We're building the desktop
  # app, not running tests, so skip it entirely.
  export DESKTOP_SKIP_PLAYWRIGHT=1
  npx --yes yarn install --frozen-lockfile
}

build() {
  cd "$_srcdir"
  export PATH="$srcdir/${_nodedir}/bin:$PATH"
  export DESKTOP_SKIP_PLAYWRIGHT=1
  npx --yes yarn build:prod
}

package() {
  cd "$_srcdir"

  local appdir="dist/desktop-u-linux-x64"
  install -d "$pkgdir/opt/desktop-u"
  cp -a "$appdir/." "$pkgdir/opt/desktop-u/"

  # electron-packager sometimes emits its output directory as 0700; `cp -a`
  # preserves that, and pacman then installs `/opt/desktop-u/` unreadable to
  # non-root, so the /usr/bin/desktop-u shim exec's a path the user can't
  # traverse ("Permission denied"). Force 0755 on the directory itself; files
  # inside keep their modes (including chrome-sandbox 4755 below).
  chmod 755 "$pkgdir/opt/desktop-u"

  # Electron's chrome-sandbox must be setuid-root or the renderer refuses to
  # start on Linux (unless launched with --no-sandbox). fakeroot preserves
  # the 4755 mode we set here into the produced pkg.tar.zst.
  chmod 4755 "$pkgdir/opt/desktop-u/chrome-sandbox"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/desktop-u" <<'EOF'
#!/bin/sh
exec /opt/desktop-u/desktop-u "$@"
EOF

  install -Dm644 linux/desktop-u.desktop \
    "$pkgdir/usr/share/applications/desktop-u.desktop"

  local size
  for size in 32 64 128 256 512 1024; do
    install -Dm644 "app/static/linux/logos/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/desktop-u.png"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
